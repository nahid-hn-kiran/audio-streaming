# PostgreSQL connection string. Do not commit the populated .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/audio_streaming?schema=public"

# Express API configuration
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Generate a high-entropy value of at least 32 characters. Never commit the value.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
OBJECT_STORAGE_PROVIDER="r2"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET="audio-streaming"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
MAX_AUDIO_UPLOAD_BYTES=104857600
UPLOAD_URL_TTL_SECONDS=900
PLAYBACK_URL_TTL_SECONDS=3600
UPLOAD_CLEANUP_GRACE_SECONDS=86400
