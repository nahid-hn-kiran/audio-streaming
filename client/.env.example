NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAX_AUDIO_UPLOAD_BYTES=104857600

# Production (Vercel): leave NEXT_PUBLIC_API_URL empty so the browser calls /api/*
# on this origin, and set SERVER_INTERNAL_URL to the deployed server URL for the rewrite.
SERVER_INTERNAL_URL=http://localhost:4000
